# Gateway
AWALL_PORT=8402
# AWALL_POLICY=/abs/path/to/awall.yaml  # default: awall.yaml found walking up from cwd
# Protected API, overriding `origin` in the policy file. A deployment addresses
# the application by its own hostname, which the file in the repository cannot
# know. Empty means the policy decides. See deploy/README.md.
AWALL_ORIGIN=

# Stellar (testnet defaults)
STELLAR_NETWORK=stellar:testnet
STELLAR_ASSET=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Native XLM SAC (testnet default). Pubnet uses CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA.
# STELLAR_XLM_ASSET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
STELLAR_PAY_TO=
# Agent: which exact rail to sign when both are offered (xlm | usdc). Default xlm.
# STELLAR_PAY_ASSET=xlm
X402_FACILITATOR_URL=https://www.x402.org/facilitator
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar on pubnet: no value above is a safe default there, so the gateway
# refuses to start until these three are set. See docs/07-producao.md.
#   STELLAR_NETWORK=stellar:pubnet
#   STELLAR_ASSET        USDC SEP-41 contract on pubnet (the testnet one does not exist there)
#   STELLAR_PAY_TO       receiving account, USDC trustline already created
#   X402_FACILITATOR_URL facilitator that settles on pubnet (x402.org is testnet)
# SOROBAN_RPC_URL is read by apps/agent-m2m, not by the gateway, and also has to
# point at a pubnet RPC there.
# Fill these in the deployed environment, never in the repository:
# STELLAR_ASSET=
# STELLAR_PAY_TO=
# X402_FACILITATOR_URL=
# SOROBAN_RPC_URL=

# Pix (AbacatePay)
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# Console. Origin of the console, with no path: the gateway appends
# /pay/<offerId> to it when it advertises the pix rail.
AWALL_CHECKOUT_BASE_URL=http://localhost:4179

# Database. Empty runs on PGlite, which is in-process and dies with the
# process; a deployment sets this. Migrations run at boot either way.
DATABASE_URL=

# Shared free-quota bucket. Required before a second replica: without it each
# replica grants the whole quota. See scripts/redis-replicas.sh.
REDIS_URL=

# Public edge (deploy/docker-compose.yml). A hostname here gives Caddy
# automatic HTTPS; empty serves plain HTTP on :80.
AWALL_DOMAIN=
AWALL_PUBLIC_BASE_URL=http://localhost:8402
# Baked into the console bundle at build time.
VITE_AWALL_URL=http://localhost:8402
# Postgres for the compose stack.
POSTGRES_USER=awall
POSTGRES_PASSWORD=
POSTGRES_DB=awall

# Set to 1 only when an edge proxy (nginx, Traefik) overwrites X-Forwarded-For.
# See docs/07-producao.md.
AWALL_TRUST_PROXY=0

# Console / plano de controle (docs/08-dashboard.md)
AWALL_ADMIN_TOKEN=
AWALL_CONSOLE_ORIGIN=http://localhost:4179
# AWALL_CONTROL_PREFIX=/awall
# AWALL_ADMIN_PORT=8403
