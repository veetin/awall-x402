{
  "name": "@awall/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4180 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:embed": "tsc -p tsconfig.json --noEmit && vite build --outDir ../console/dist/documentacao --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0 --port 4180 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.6.0",
    "vite": "^7.2.2",
    "vitest": "^2.1.0"
  }
}
