{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/$", "dest": "/landing.html" },
    { "src": "^/landing/?$", "dest": "/landing.html" },
    { "src": "^/documentacao/?$", "dest": "/documentacao/index.html" },
    { "handle": "filesystem" }
  ]
}
