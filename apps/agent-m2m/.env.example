# Stellar testnet hot wallet of the agent. Written by `setup:testnet` when
# absent, never committed, never logged.
STELLAR_SECRET=

# Receiving account, used only by `setup:testnet` to give it a USDC trustline.
# The gateway needs the matching public key in STELLAR_PAY_TO.
STELLAR_PAY_TO_SECRET=

# Network (testnet defaults)
STELLAR_NETWORK=stellar:testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Which exact rail to sign when the 402 offers both (xlm | usdc). Default xlm.
STELLAR_PAY_ASSET=xlm

# Agent loop
AWALL_GATEWAY_URL=http://localhost:8402
AGENT_TARGET_PATH=/v1/search?q=camera
AGENT_REQUESTS=40
AGENT_INTERVAL_MS=120
# High enough for the XLM pack under the abuse multiplier.
AGENT_MAX_PAYMENT_USD=$20
