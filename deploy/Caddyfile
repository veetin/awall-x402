# Public edge for a single host.
# The gateway keeps /awall for itself. Everything else is the protected API,
# except the console paths, which stay on the static app.
#
# {$AWALL_DOMAIN::80} is the site address: a hostname gives automatic HTTPS,
# with Caddy obtaining and renewing the certificate, and the default `:80`
# serves plain HTTP for a local run. Set AWALL_DOMAIN to the public name.
{$AWALL_DOMAIN::80} {
	handle /awall/* {
		reverse_proxy gateway:8402
	}
	handle /pay/* {
		reverse_proxy console:4179
	}
	handle /login {
		reverse_proxy console:4179
	}
	handle /live* {
		reverse_proxy console:4179
	}
	handle /requests* {
		reverse_proxy console:4179
	}
	handle /revenue* {
		reverse_proxy console:4179
	}
	handle /identities* {
		reverse_proxy console:4179
	}
	handle /payments* {
		reverse_proxy console:4179
	}
	handle /policy* {
		reverse_proxy console:4179
	}
	handle /health {
		reverse_proxy console:4179
	}
	# The console is served from the root, and its bundle asks for
	# /assets/* and /favicon.ico from the same origin.
	handle /assets/* {
		reverse_proxy console:4179
	}
	handle /favicon.ico {
		reverse_proxy console:4179
	}
	handle / {
		reverse_proxy console:4179
	}
	handle {
		reverse_proxy gateway:8402
	}
}
